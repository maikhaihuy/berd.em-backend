@startuml
skinparam linetype ortho
skinparam packageStyle rectangle
left to right direction

' ===================== AUTH & USER =====================
package "Authentication & Authorization" as AUTH #cfe2ff {
  
  entity User {
    *id : Int <<PK>>
    --
    zaloId : String <<Unique>> (ID định danh từ Zalo)
    phoneNumber : String <<Unique>>
    fullName : String
    avatarUrl : String?
    status : Enum(ACTIVE, INACTIVE)
    roleId : Int <<FK>> (Một user chỉ có 1 role chính)
    --
    createdAt : DateTime
    updatedAt : DateTime
  }

  entity Role {
    *id : Int <<PK>>
    --
    name : String (ADMIN, MANAGER, STAFF)
    description : String
  }

  entity Permission {
    *id : Int <<PK>>
    --
    action : String (manage, read, create, update, delete)
    subject : String (Employee, Order, Branch, etc.)
    condition : Json (Dùng cho CASL - ví dụ: {"branchId": "${branchId}"})
    description : String?
  }

  entity RolePermission {
    *roleId : Int <<PK, FK>>
    *permissionId : Int <<PK, FK>>
  }

  entity RefreshToken {
    *id : Int <<PK>>
    --
    userId : Int <<FK>>
    hashedToken : String?
    device : String?
    ipAddress : String?
    expiresAt : DateTime
    createdAt : DateTime
  }

  entity PasswordResetToken {
    *id : Int <<PK>>
    --
    userId : Int <<FK>>
    hashedToken : String?
    expiresAt : DateTime
    createdAt : DateTime
  }
}

' ===================== CORE ENTITIES =====================
package "Core Entities" as CORE #d1e7dd {
  left to right direction

  entity Branch {
    *id Int <<PK>>
    --
    name: String
    abbreviation: String
    address: String
    email: String?
    phone: String?
    --
    createdAt: DateTime
    createdBy: Int
    updatedAt: DateTime
    updatedBy: Int
  }

  entity Employee {
    * id Int <<PK>>
    userId: Int <<FK>>
    --
    fullName: String
    phoneNumber: String
    dateOfBirth: Date?
    avatar: String?
    email: String?
    address: String?
    probationStartDate: Date?
    officialStartDate: Date?
    --
    createdAt: DateTime
    createdBy: Int
    updatedAt: DateTime
    updatedBy: Int
  }

  entity EmployeeHourlyRate {
    * id Int <<PK>>
    employeeId: Int <<FK>>
    --
    rate: Decimal
    effectiveDate: Date
    endDate: Date?
    note: String?
    --
    createdAt: DateTime
    createdBy: Int
    updatedAt: DateTime
    updatedBy: Int
  }

  entity EmployeeBranch {
    *employeeId Int <<PK, FK, Int>>
    *branchId Int <<PK, FK, Int>>
    IsPrimary: Boolean
  }

  entity Availability {
    *id Int <<PK>>
    --
    employeeId Int <<FK, Int>>
    subShiftId Int <<FK, Int>>
    startTime: DateTimeOffset?
    endTime: DateTimeOffset?
    status: Enum: Registered, Assigned, Cancelled
    note: String?
    --
    createdAt: DateTime
    createdBy: Int
    updatedAt: DateTime
    updatedBy: Int
  }
}

' ===================== SHIFT MANAGEMENT =====================
package "Shift Management" as SHIFT #fff3cd {
  left to right direction

  entity BranchScheduleConfig {
    *id Int <<PK>>
    branchId Int <<Unique, FK>>
    --
    allowCustomAvailabilityTime: Boolean
    availabilityOpenDaysBefore: Int?
    availabilityCloseHoursBefore: Int?
    scheduleGenerationDay: Int?
    note: String?
    --
    createdAt: DateTime
    createdBy: Int
    updatedAt: DateTime
    updatedBy: Int
  }

  entity MasterShiftTemplate {
    *id Int <<PK>>
    branchId Int <<FK, Int>>
    --
    name: String
    abbreviation: String?
    startTime: Time
    endTime: Time
    status: Enum: Draft, Active, Inactive, Archived
    note: String?
    --
    createdAt: DateTime
    createdBy: Int
    updatedAt: DateTime
    updatedBy: Int
  }

  entity SubShiftTemplate {
    *id Int <<PK>>
    branchId Int <<FK, Int>>
    masterShiftTemplateId Int <<FK, Int>>
    --
    name: String
    type: Enum: MAIN, SUPPORT
    startTime: Time
    endTime: Time
    maxAssignments: Int?
    sortOrder: Int
    status: Enum: Draft, Active, Inactive, Archived
    note: String?
    --
    createdAt: DateTime
    createdBy: Int
    updatedAt: DateTime
    updatedBy: Int
  }

  entity TaskTemplate {
    *id Int <<PK>>
    branchId Int <<FK, Int>>
    masterShiftTemplateId Int <<FK, Int?>>
    subShiftTemplateId Int <<FK, Int?>>
    --
    title: String
    description: String?
    type: Enum: SharedMandatory, SharedOptional, Dedicated
    isActive: Boolean
    sortOrder: Int
    note: String?
    --
    createdAt: DateTime
    createdBy: Int
    updatedAt: DateTime
    updatedBy: Int
  }

  entity MasterShift {
    *id Int <<PK>>
    branchId Int <<FK, Int>>
    masterShiftTemplateId Int <<FK, Int?>>
    --
    workDate: Date
    title: String
    startTime: DateTime
    endTime: DateTime
    status: Enum: Draft, Active, Inactive, Archived
    note: String?
    --
    createdAt: DateTime
    createdBy: Int
    updatedAt: DateTime
    updatedBy: Int
  }

  entity SubShift {
    *id Int <<PK>>
    masterShiftId Int <<FK, Int>>
    subShiftTemplateId Int <<FK, Int?>>
    --
    title: String
    type: Enum: MAIN, SUPPORT
    startTime: DateTime
    endTime: DateTime
    maxAssignments: Int?
    status: Enum: Draft, Active, Inactive, Archived
    note: String?
    --
    createdAt: DateTime
    createdBy: Int
    updatedAt: DateTime
    updatedBy: Int
  }

  entity Assignment {
    *id Int <<PK>>
    employeeId Int <<FK, Int>>
    subShiftId Int <<FK, Int>>
    availabilityId Int <<Unique, FK, Int?>>
    --
    assignedAt: DateTime
    actualStartTime: DateTime?
    actualEndTime: DateTime?
    status: Enum: Scheduled, InProgress, Completed, Absent
    note: String?
    --
    createdAt: DateTime
    createdBy: Int
    updatedAt: DateTime
    updatedBy: Int
  }

  entity Task {
    *id Int <<PK>>
    taskTemplateId Int <<FK, Int?>>
    masterShiftId Int <<FK, Int?>>
    subShiftId Int <<FK, Int?>>
    --
    title: String
    description: String?
    type: Enum: SharedMandatory, SharedOptional, Dedicated
    status: Enum: Pending, Completed
    sortOrder: Int
    dueAt: DateTime?
    note: String?
    --
    createdAt: DateTime
    createdBy: Int
    updatedAt: DateTime
    updatedBy: Int
  }

  entity TaskCompletion {
    *id Int <<PK>>
    taskId Int <<Unique, FK, Int>>
    completedByEmployeeId Int <<FK, Int>>
    --
    completedAt: DateTime
    evidence: Json?
    note: String?
    --
    createdAt: DateTime
    createdBy: Int
    updatedAt: DateTime
    updatedBy: Int
  }

  entity AttendanceHistory {
    *id Int <<PK>>
    assignmentId: Int <<FK, Int>>
    --
    action: Enum: CHECK_IN, CHECK_OUT, REPLACEMENT_REQUEST, MANAGER_ADJUSTMENT
    detail: Json?
    --
    createdAt: DateTime
    createdBy: Int
  }

  entity LeaveRequest {
    *id Int <<PK>>
    assignmentId Int <<FK, Int>>
    replacementEmployeeId Int <<FK, Int>>
    absenceEmployeeId Int <<FK, Int>>
    approvedId Int <<FK, Int?>>
    --
    reason: String?
    note: String?
    status: Enum: Pending, Approved, Rejected, Cancelled)
    approvedAt: DateTime?
    --
    createdAt: DateTime
    createdBy: Int
    updatedAt: DateTime
    updatedBy: Int
  }
}

' ===================== PAYMENT MANAGEMENT =====================
package "Payment Management" as PAY #f8d7da {
  left to right direction

  entity TimeLog {
    *id Int <<PK>>
    assignmentId Int <<FK, Int>>
    employeeId Int <<FK, Int>>
    --
    actualStartTime: DateTimeOffset?
    actualEndTime: DateTimeOffset?
    requestStartTime: DateTimeOffset?
    requestEndTime: DateTimeOffset?
    overtimeMinutes: Int?
    multiplier: Decimal
    requestDate: DateTimeOffset?
    requestReason: String?
    status: Enum: Pending, Submitted, Verified, Rejected
    verifiedBy: Int?
    verifiedAt: DateTimeOffset?
    note: String?
    --
    createdAt: DateTime
    createdBy: Int
    updatedAt: DateTime
    updatedBy: Int
  }

  entity PayPeriod {
    *id Int <<PK>>
    --
    startDate: Date
    endDate: Date
    status: Enum: Open, Closed, Finalized
    notes: String?
    --
    createdAt: DateTime
    createdBy: Int
    updatedAt: DateTime
    updatedBy: Int
  }

  entity PayrollEntry {
    *id Int <<PK>>
    --
    timeLogId Int <<FK, Int>>
    employeeId Int <<FK, Int>>
    payPeriodId Int <<FK, Int>>
    payDate: Date
    workDate: Date
    calculatedAt: DateTime
    calculatedBy: Int <<FK, Int>>
    totalPay: Decimal
    --
    createdAt: DateTime
    createdBy: Int
    updatedAt: DateTime
    updatedBy: Int
  }
}

' ===================== RELATIONSHIPS =====================

User }|--|| Role
Role ||--|{ RolePermission
Permission ||--|{ RolePermission
User ||--|{ RefreshToken

EmployeeBranch }o--|| Employee : "employeeId"
EmployeeBranch }o--|| Branch : "branchId"
EmployeeHourlyRate }o--|| Employee : "employeeId"
User |o--o| Employee : "employeeId"

BranchScheduleConfig }o--|| Branch : "branchId"
MasterShiftTemplate }o--|| Branch : "branchId"
SubShiftTemplate }o--|| Branch : "branchId"
SubShiftTemplate }o--|| MasterShiftTemplate : "masterShiftTemplateId"
TaskTemplate }o--|| Branch : "branchId"
TaskTemplate }o--o| MasterShiftTemplate : "masterShiftTemplateId"
TaskTemplate }o--o| SubShiftTemplate : "subShiftTemplateId"
MasterShift }o--|| Branch : "branchId"
MasterShift }o--o| MasterShiftTemplate : "masterShiftTemplateId"
SubShift }o--|| MasterShift : "masterShiftId"
SubShift }o--o| SubShiftTemplate : "subShiftTemplateId"
Assignment }o--|| Employee : "employeeId"
Assignment }o--|| SubShift : "subShiftId"
Assignment }o--o| Availability : "availabilityId"
Task }o--o| TaskTemplate : "taskTemplateId"
Task }o--o| MasterShift : "masterShiftId"
Task }o--o| SubShift : "subShiftId"
TaskCompletion ||--|| Task : "taskId"
TaskCompletion }o--|| Employee : "completedByEmployeeId"
AttendanceHistory }o--|| Assignment : "assignmentId"
LeaveRequest }o--|| Employee : "absenceEmployeeId"
LeaveRequest }o--|| Employee : "replacementEmployeeId"
LeaveRequest }o--|| Assignment : "assignmentId"

Availability }o--|| Employee : "employeeId"
Availability }o--|| SubShift : "subShiftId"

TimeLog }o--|| Employee : "employeeId"
TimeLog }o--|| Assignment : "assignmentId"

PayrollEntry }o--|| Employee : "employeeId"
PayrollEntry }o--|| PayPeriod : "payPeriodId"
PayrollEntry ||--o| TimeLog : "timeLogId"

@enduml
