# Database
DATABASE_URL=postgresql://postgres:xxx@localhost:5432/berd_em_dev

# JWT
JWT_ACCESS_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_ACCESS_EXPIRATION="2m"

# JWT_REFRESH
JWT_REFRESH_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_REFRESH_EXPIRATION="4m"

# App
PORT=3000
NODE_ENV=development

# CORS (comma-separated list of allowed browser origins)
CORS_ALLOWED_ORIGINS="http://localhost:3016"

# Auto-provisioned employee credentials
# Days an unclaimed one-time password stays valid before an Admin must re-issue it
INITIAL_PASSWORD_TTL_DAYS=7

# File uploads (Cloudflare R2, S3-compatible)
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="staffhub-uploads"
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# Optional upload limits (defaults used if unset)
UPLOAD_MAX_FILE_SIZE_BYTES=8388608
UPLOAD_MAX_FILES_PER_REQUEST=5