// schema.prisma - Updated for ERD v0.3.1
// Major changes: Zalo auth, branch-owned shift/task templates, generated shifts, assignments

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TimeLogStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

enum PayPeriodStatus {
  OPEN
  CLOSED
  FINALIZED
}

enum ShiftStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum WorkSlotStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  ABSENT
}

enum SubShiftType {
  MAIN
  SUPPORT
}

enum AvailabilityStatus {
  REGISTERED
  ASSIGNED
  CANCELLED
}

enum TaskType {
  SHARED_MANDATORY
  SHARED_OPTIONAL
  DEDICATED
}

enum TaskStatus {
  PENDING
  COMPLETED
}

enum AttendanceAction {
  CHECK_IN
  CHECK_OUT
  REPLACEMENT_REQUEST
  MANAGER_ADJUST
}

// ==================== AUTH & USER MANAGEMENT ====================

model User {
  id                          Int           @id @default(autoincrement())
  phoneNumber                 String        @unique
  password                    String?
  fullName                    String
  avatarUrl                   String?
  status                      UserStatus
  mustChangePassword          Boolean       @default(false)
  mustChangePasswordExpiresAt DateTime?
  employee                    Employee? // optional relation
  zaloIdentity                ZaloIdentity?

  userRoles       UserRole[]
  managerBranches ManagerBranch[]

  refreshTokens RefreshToken[]
  resetTokens   PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model ZaloIdentity {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique
  zaloUserId     String    @unique
  displayName    String?
  avatarUrl      String?
  lastVerifiedAt DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("zalo_identities")
}

model Role {
  id           Int     @id @default(autoincrement())
  name         String  @unique
  description  String?
  isSystemRole Boolean @default(false)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  createdBy Int
  updatedAt DateTime @updatedAt
  updatedBy Int

  @@map("roles")
}

model Permission {
  id          Int     @id @default(autoincrement())
  action      String
  subject     String
  description String?

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  createdBy Int
  updatedAt DateTime @updatedAt
  updatedBy Int

  @@unique([action, subject])
  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int
  condition    Json?
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId Int
  roleId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@map("user_roles")
}

// ManagerBranch records which branches a user manages (for `$managedBranches`
// permission-condition scoping) — independent of EmployeeBranch, which
// records where an employee works.
model ManagerBranch {
  userId   Int
  branchId Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, branchId])
  @@map("manager_branches")
}

