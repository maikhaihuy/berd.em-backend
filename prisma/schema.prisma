model RefreshToken {
  id          String   @id @default(uuid()) @db.Uuid
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashedToken String
  source      String?
  device      String?
  ipAddress   String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  hashToken String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

// ==================== CORE ENTITIES ====================

model Branch {
  id           Int     @id @default(autoincrement())
  name         String
  abbreviation String
  address      String
  email        String?
  phone        String?

  employeeBranches     EmployeeBranch[]
  managerBranches      ManagerBranch[]
  scheduleConfig       BranchScheduleConfig?
  masterShiftTemplates MasterShiftTemplate[]
  subShiftTemplates    SubShiftTemplate[]
  taskTemplates        TaskTemplate[]
  masterShifts         MasterShift[]

  createdAt DateTime @default(now())
  createdBy Int
  updatedAt DateTime @updatedAt
  updatedBy Int

  @@map("branches")
}

model Employee {
  id                 Int       @id @default(autoincrement())
  fullName           String
  phoneNumber        String    @unique
  dateOfBirth        DateTime?
  avatar             String?
  email              String?
  address            String?
  probationStartDate DateTime?
  officialStartDate  DateTime?

  userId Int?  @unique // ⚠️ cho phép null lúc đầu, sau đó sẽ gán khi nhân viên được tạo
  user   User? @relation(fields: [userId], references: [id])

  hourlyRates                EmployeeHourlyRate[]
  employeeBranches           EmployeeBranch[]
  availabilities             Availability[]
  assignments                Assignment[]
  taskCompletions            TaskCompletion[]
  leaveRequestsAsAbsence     LeaveRequest[]       @relation("AbsenceEmployee")
  leaveRequestsAsReplacement LeaveRequest[]       @relation("ReplacementEmployee")
  timeLogsAsEmployee         TimeLog[]            @relation("EmployeeTimeLogs")
  timeLogsAsVerifier         TimeLog[]            @relation("VerifierTimeLogs")
  payrollEntries             PayrollEntry[]

  createdAt DateTime @default(now())
  createdBy Int
  updatedAt DateTime @updatedAt
  updatedBy Int

  @@map("employees")
}

model EmployeeHourlyRate {
  id            Int       @id @default(autoincrement())
  employeeId    Int
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  rate          Decimal   @db.Decimal(10, 2)
  effectiveDate DateTime
  endDate       DateTime?
  note          String?

  createdAt DateTime @default(now())
  createdBy Int
  updatedAt DateTime @updatedAt
  updatedBy Int

  @@map("employee_hourly_rates")
}

model EmployeeBranch {
  employeeId Int
  branchId   Int
  isPrimary  Boolean  @default(false)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([employeeId, branchId])
  @@map("employee_branches")
}

model Availability {
  id         Int                @id @default(autoincrement())
  employeeId Int
  subShiftId Int
  employee   Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  subShift   SubShift           @relation(fields: [subShiftId], references: [id], onDelete: Cascade)
  startTime  DateTime?
  endTime    DateTime?
  status     AvailabilityStatus @default(REGISTERED)
  note       String?
  assignment Assignment?

  createdAt DateTime @default(now())
  createdBy Int
  updatedAt DateTime @updatedAt
  updatedBy Int

  @@unique([employeeId, subShiftId])
  @@index([subShiftId])
  @@map("availabilities")
}

// ==================== SHIFT MANAGEMENT ====================

model BranchScheduleConfig {
  id                           Int     @id @default(autoincrement())
  branchId                     Int     @unique
  branch                       Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  allowCustomAvailabilityTime  Boolean @default(false)
  availabilityOpenDaysBefore   Int?
  availabilityCloseHoursBefore Int?
  scheduleGenerationDay        Int?
  note                         String?

  createdAt DateTime @default(now())
  createdBy Int
  updatedAt DateTime @updatedAt
  updatedBy Int

  @@map("branch_schedule_configs")
}

model MasterShiftTemplate {
  id           Int         @id @default(autoincrement())
  branchId     Int
  branch       Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name         String
  abbreviation String?
  startTime    DateTime    @db.Time
  endTime      DateTime    @db.Time
  status       ShiftStatus @default(ACTIVE)
  note         String?

  subShiftTemplates SubShiftTemplate[]
  taskTemplates     TaskTemplate[]
  masterShifts      MasterShift[]

  createdAt DateTime @default(now())
  createdBy Int
  updatedAt DateTime @updatedAt
  updatedBy Int

  @@unique([branchId, name])
  @@map("master_shift_templates")
}

model SubShiftTemplate {
  id                    Int                 @id @default(autoincrement())
  branchId              Int
  masterShiftTemplateId Int
  branch                Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  masterShiftTemplate   MasterShiftTemplate @relation(fields: [masterShiftTemplateId], references: [id], onDelete: Cascade)
  name                  String
  type                  SubShiftType
  startTime             DateTime            @db.Time
  endTime               DateTime            @db.Time
  maxAssignments        Int?
  sortOrder             Int                 @default(0)
  status                ShiftStatus         @default(ACTIVE)
  note                  String?

  taskTemplates TaskTemplate[]
  subShifts     SubShift[]

  createdAt DateTime @default(now())
  createdBy Int
  updatedAt DateTime @updatedAt
  updatedBy Int

  @@index([branchId])
  @@index([masterShiftTemplateId])
  @@map("sub_shift_templates")
}

model TaskTemplate {
  id                    Int                  @id @default(autoincrement())
  branchId              Int
  masterShiftTemplateId Int?
  subShiftTemplateId    Int?
  branch                Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  masterShiftTemplate   MasterShiftTemplate? @relation(fields: [masterShiftTemplateId], references: [id], onDelete: Cascade)
  subShiftTemplate      SubShiftTemplate?    @relation(fields: [subShiftTemplateId], references: [id], onDelete: Cascade)
  title                 String
  description           String?
  type                  TaskType
  isActive              Boolean              @default(true)
  sortOrder             Int                  @default(0)
  note                  String?

  tasks Task[]

  createdAt DateTime @default(now())
  createdBy Int
  updatedAt DateTime @updatedAt
  updatedBy Int

  @@index([branchId])
  @@index([masterShiftTemplateId])
  @@index([subShiftTemplateId])
  @@map("task_templates")
}

model MasterShift {
  id                    Int                  @id @default(autoincrement())
  branchId              Int
  masterShiftTemplateId Int?
  branch                Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  masterShiftTemplate   MasterShiftTemplate? @relation(fields: [masterShiftTemplateId], references: [id], onDelete: SetNull)
  workDate              DateTime             @db.Date
  title                 String
  startTime             DateTime
  endTime               DateTime
  status                ShiftStatus          @default(ACTIVE)
  note                  String?

  subShifts SubShift[]
  tasks     Task[]

  createdAt DateTime @default(now())
  createdBy Int
  updatedAt DateTime @updatedAt
  updatedBy Int

  @@unique([branchId, workDate, title])
  @@index([masterShiftTemplateId])
  @@map("master_shifts")
}

model SubShift {
  id                 Int               @id @default(autoincrement())
  masterShiftId      Int
  subShiftTemplateId Int?
  masterShift        MasterShift       @relation(fields: [masterShiftId], references: [id], onDelete: Cascade)
  subShiftTemplate   SubShiftTemplate? @relation(fields: [subShiftTemplateId], references: [id], onDelete: SetNull)
  title              String
  type               SubShiftType
  startTime          DateTime
  endTime            DateTime
  maxAssignments     Int?
  status             ShiftStatus       @default(ACTIVE)
  note               String?

  availabilities Availability[]
  assignments    Assignment[]
  tasks          Task[]

  createdAt DateTime @default(now())
  createdBy Int
  updatedAt DateTime @updatedAt
  updatedBy Int

  @@index([masterShiftId])
  @@index([subShiftTemplateId])
  @@map("sub_shifts")
}

model Assignment {
  id              Int            @id @default(autoincrement())
  employeeId      Int
  subShiftId      Int
  availabilityId  Int?           @unique
  employee        Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  subShift        SubShift       @relation(fields: [subShiftId], references: [id], onDelete: Cascade)
  availability    Availability?  @relation(fields: [availabilityId], references: [id], onDelete: SetNull)
  assignedAt      DateTime       @default(now())
  actualStartTime DateTime?
  actualEndTime   DateTime?
  status          WorkSlotStatus @default(SCHEDULED)
  note            String?

  attendanceHistories AttendanceHistory[]
  leaveRequests       LeaveRequest[]
  timeLogs            TimeLog[]

  createdAt DateTime @default(now())
  createdBy Int
  updatedAt DateTime @updatedAt
  updatedBy Int

  @@unique([employeeId, subShiftId])
  @@index([subShiftId])
  @@map("assignments")
}

model Task {
  id             Int           @id @default(autoincrement())
  taskTemplateId Int?
  masterShiftId  Int?
  subShiftId     Int?
  taskTemplate   TaskTemplate? @relation(fields: [taskTemplateId], references: [id], onDelete: SetNull)
  masterShift    MasterShift?  @relation(fields: [masterShiftId], references: [id], onDelete: Cascade)
  subShift       SubShift?     @relation(fields: [subShiftId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  type           TaskType
  status         TaskStatus    @default(PENDING)
  sortOrder      Int           @default(0)
  dueAt          DateTime?
  note           String?

  completion TaskCompletion?

  createdAt DateTime @default(now())
  createdBy Int
  updatedAt DateTime @updatedAt
  updatedBy Int

  @@index([taskTemplateId])
  @@index([masterShiftId])
  @@index([subShiftId])
  @@map("tasks")
}

model TaskCompletion {
  id                    Int      @id @default(autoincrement())
  taskId                Int      @unique
  completedByEmployeeId Int
  task                  Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  completedByEmployee   Employee @relation(fields: [completedByEmployeeId], references: [id])
  completedAt           DateTime @default(now())
  evidence              Json?
  note                  String?

  createdAt DateTime @default(now())
  createdBy Int
  updatedAt DateTime @updatedAt
  updatedBy Int

  @@index([completedByEmployeeId])
  @@map("task_completions")
}

model AttendanceHistory {
  id           Int              @id @default(autoincrement())
  assignmentId Int
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  action       AttendanceAction
  detail       Json?

  createdAt DateTime @default(now())
  createdBy Int

  @@index([assignmentId])
  @@map("attendance_histories")
}

model LeaveRequest {
  id                    Int        @id @default(autoincrement())
  assignmentId          Int
  absenceEmployeeId     Int
  replacementEmployeeId Int
  approvedId            Int?
  assignment            Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  absenceEmployee       Employee   @relation("AbsenceEmployee", fields: [absenceEmployeeId], references: [id])
  replacementEmployee   Employee   @relation("ReplacementEmployee", fields: [replacementEmployeeId], references: [id])

  reason     String?
  note       String?
  status     LeaveStatus
  approvedAt DateTime?

  createdAt DateTime @default(now())
  createdBy Int
  updatedAt DateTime @updatedAt
  updatedBy Int

  @@index([assignmentId])
  @@map("leave_requests")
}

// ==================== PAYMENT MANAGEMENT ====================

model TimeLog {
  id           Int        @id @default(autoincrement())
  assignmentId Int
  employeeId   Int
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  employee     Employee   @relation("EmployeeTimeLogs", fields: [employeeId], references: [id])

  actualStartTime  DateTime?
  actualEndTime    DateTime?
  requestStartTime DateTime?
  requestEndTime   DateTime?
  overtimeMinutes  Int?
  multiplier       Decimal       @db.Decimal(4, 2)
  requestDate      DateTime?
  requestReason    String?
  status           TimeLogStatus
  verifiedBy       Int?
  verifier         Employee?     @relation("VerifierTimeLogs", fields: [verifiedBy], references: [id])
  verifiedAt       DateTime?
  note             String?

  payrollEntry PayrollEntry?

  createdAt DateTime @default(now())
  createdBy Int
  updatedAt DateTime @updatedAt
  updatedBy Int

  @@index([assignmentId])
  @@map("time_logs")
}

model PayPeriod {
  id        Int             @id @default(autoincrement())
  startDate DateTime
  endDate   DateTime
  status    PayPeriodStatus
  notes     String?

  payrollEntries PayrollEntry[]

  createdAt DateTime @default(now())
  createdBy Int
  updatedAt DateTime @updatedAt
  updatedBy Int

  @@map("pay_periods")
}

model PayrollEntry {
  id          Int       @id @default(autoincrement())
  timeLogId   Int       @unique
  employeeId  Int
  payPeriodId Int
  timeLog     TimeLog   @relation(fields: [timeLogId], references: [id], onDelete: Cascade)
  employee    Employee  @relation(fields: [employeeId], references: [id])
  payPeriod   PayPeriod @relation(fields: [payPeriodId], references: [id])

  payDate      DateTime
  workDate     DateTime
  calculatedAt DateTime
  calculatedBy Int
  totalPay     Decimal  @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  createdBy Int
  updatedAt DateTime @updatedAt
  updatedBy Int

  @@map("payroll_entries")
}

// Append-only audit trail for mutations on audited subjects. Deliberately
// has no updatedBy/updatedAt (rows are never mutated once written) and
// `actorId` is a plain scalar, not a FK relation — same convention as
// createdBy/updatedBy elsewhere in this schema.
model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int
  action    String
  subject   String
  entityId  Int
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([subject, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}
