model RefreshToken {
  id          String   @id @default(uuid()) @db.Uuid
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashedToken String
  device      String?
  ipAddress   String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String  @id @default(uuid()) @db.Uuid
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  hashToken String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

// ==================== CORE ENTITIES ====================

model Branch {
  id           Int      @id @default(autoincrement())
  name         String
  abbreviation String
  address      String
  email        String?
  phone        String?
  
  employeeBranches EmployeeBranch[]
  shifts           Shift[]
  workSlots        WorkSlot[]
  
  createdAt    DateTime @default(now())
  createdBy    Int
  updatedAt    DateTime @updatedAt
  updatedBy    Int
  
  @@map("branches")
}

model Employee {
  id                  Int       @id @default(autoincrement())
  fullName            String
  phoneNumber         String   @unique
  dateOfBirth         DateTime?
  avatar              String?
  email               String?
  address             String?
  probationStartDate  DateTime?
  officialStartDate   DateTime?

  userId              Int? @unique  // ⚠️ cho phép null lúc đầu, sau đó sẽ gán khi nhân viên được tạo
  user                User? @relation(fields: [userId], references: [id])
  
  hourlyRates                EmployeeHourlyRate[]
  employeeBranches           EmployeeBranch[]
  availabilities             Availability[]
  workSlots                  WorkSlot[]
  leaveRequestsAsAbsence     LeaveRequest[]       @relation("AbsenceEmployee")
  leaveRequestsAsReplacement LeaveRequest[]       @relation("ReplacementEmployee")
  timeLogsAsEmployee         TimeLog[]            @relation("EmployeeTimeLogs")
  timeLogsAsVerifier         TimeLog[]            @relation("VerifierTimeLogs")
  payrollEntries             PayrollEntry[]
  
  createdAt           DateTime  @default(now())
  createdBy           Int
  updatedAt           DateTime  @updatedAt
  updatedBy           Int
  
  @@map("employees")
}

model EmployeeHourlyRate {
  id            Int       @id @default(autoincrement())
  employeeId    Int
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  rate          Decimal   @db.Decimal(10, 2)
  effectiveDate DateTime
  endDate       DateTime?
  note          String?
  
  createdAt     DateTime  @default(now())
  createdBy     Int
  updatedAt     DateTime  @updatedAt
  updatedBy     Int
  
  @@map("employee_hourly_rates")
}

model EmployeeBranch {
  employeeId Int
  branchId   Int
  isPrimary  Boolean  @default(false)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  
  @@id([employeeId, branchId])
  @@map("employee_branches")
}

model Availability {
  id         Int       @id @default(autoincrement())
  employeeId Int
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startTime  DateTime
  endTime    DateTime
  note       String?
  
  createdAt  DateTime  @default(now())
  createdBy  Int
  updatedAt  DateTime  @updatedAt
  updatedBy  Int
  
  @@map("availabilities")
}

// ==================== SHIFT MANAGEMENT ====================

model Shift {
  id           Int         @id @default(autoincrement())
  branchId     Int
  branch       Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name         String
  abbreviation String
  maxSlots     Int
  startTime    DateTime    @db.Time
  endTime      DateTime    @db.Time
  multiplier   Int
  status       ShiftStatus
  
  createdAt    DateTime    @default(now())
  createdBy    Int
  updatedAt    DateTime    @updatedAt
  updatedBy    Int
  
  @@map("shifts")
}

model WorkSlot {
  id               Int            @id @default(autoincrement())
  branchId         Int
  employeeId       Int
  branch           Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  employee         Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  assignedAt       DateTime
  startTime        DateTime
  endTime          DateTime
  actualStartTime  DateTime?
  actualEndTime    DateTime?
  status           WorkSlotStatus @default(SCHEDULED)
  note             String?
  
  attendanceHistories AttendanceHistory[]
  leaveRequests       LeaveRequest[]
  timeLogs            TimeLog[]
  
  createdAt        DateTime  @default(now())
  createdBy        Int
  updatedAt        DateTime  @updatedAt
  updatedBy        Int
  
  @@map("work_slots")
}

model AttendanceHistory {
  id         Int              @id @default(autoincrement())
  workSlotId Int
  workSlot   WorkSlot         @relation(fields: [workSlotId], references: [id], onDelete: Cascade)
  action     AttendanceAction
  detail     Json?
  
  createdAt  DateTime  @default(now())
  createdBy  Int
  
  @@map("attendance_histories")
}

model LeaveRequest {
  id                    Int         @id @default(autoincrement())
  workSlotId            Int
  absenceEmployeeId     Int
  replacementEmployeeId Int
  approvedId            Int?
  workSlot              WorkSlot    @relation(fields: [workSlotId], references: [id], onDelete: Cascade)
  absenceEmployee       Employee    @relation("AbsenceEmployee", fields: [absenceEmployeeId], references: [id])
  replacementEmployee   Employee    @relation("ReplacementEmployee", fields: [replacementEmployeeId], references: [id])
  
  reason                String?
  note                  String?
  status                LeaveStatus
  approvedAt            DateTime?
  
  createdAt             DateTime    @default(now())
  createdBy             Int
  updatedAt             DateTime    @updatedAt
  updatedBy             Int
  
  @@map("leave_requests")
}

// ==================== PAYMENT MANAGEMENT ====================

model TimeLog {
  id                Int           @id @default(autoincrement())
  workSlotId        Int
  employeeId        Int
  workSlot          WorkSlot      @relation(fields: [workSlotId], references: [id], onDelete: Cascade)
  employee          Employee      @relation("EmployeeTimeLogs", fields: [employeeId], references: [id])
  
  actualStartTime   DateTime?
  actualEndTime     DateTime?
  requestStartTime  DateTime?
  requestEndTime    DateTime?
  overtimeMinutes   Int?
  multiplier        Decimal       @db.Decimal(4, 2)
  requestDate       DateTime?
  requestReason     String?
  status            TimeLogStatus
  verifiedBy        Int?
  verifier          Employee?     @relation("VerifierTimeLogs", fields: [verifiedBy], references: [id])
  verifiedAt        DateTime?
  note              String?
  
  payrollEntry      PayrollEntry?
  
  createdAt         DateTime  @default(now())
  createdBy         Int
  updatedAt         DateTime  @updatedAt
  updatedBy         Int
  
  @@map("time_logs")
}

model PayPeriod {
  id        Int             @id @default(autoincrement())
  startDate DateTime
  endDate   DateTime
  status    PayPeriodStatus
  notes     String?
  
  payrollEntries PayrollEntry[]
  
  createdAt DateTime  @default(now())
  createdBy Int
  updatedAt DateTime  @updatedAt
  updatedBy Int
  
  @@map("pay_periods")
}

model PayrollEntry {
  id           Int       @id @default(autoincrement())
  timeLogId    Int       @unique
  employeeId   Int
  payPeriodId  Int
  timeLog      TimeLog   @relation(fields: [timeLogId], references: [id], onDelete: Cascade)
  employee     Employee  @relation(fields: [employeeId], references: [id])
  payPeriod    PayPeriod @relation(fields: [payPeriodId], references: [id])
  
  payDate      DateTime
  workDate     DateTime
  calculatedAt DateTime
  calculatedBy Int
  totalPay     Decimal   @db.Decimal(12, 2)
  
  createdAt    DateTime  @default(now())
  createdBy    Int
  updatedAt    DateTime  @updatedAt
  updatedBy    Int
  
  @@map("payroll_entries")
}
